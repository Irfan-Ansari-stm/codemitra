# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://codeverse_app:YOUR_PASSWORD@localhost:5432/codemitra?sslmode=disable
DB_POOL_MAX=20

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_256_bit_random_hex
JWT_REFRESH_SECRET=replace_with_different_256_bit_random_hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Judge0 ──────────────────────────────────────────────────────────────────
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
